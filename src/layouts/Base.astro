---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site.js';

const { title, description, active = '' } = Astro.props;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  name: SITE.name,
  telephone: '+1-519-245-5945',
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postal,
    addressCountry: 'CA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 42.9565, longitude: -81.6222 },
  url: 'https://premierheating.ca',
  parentOrganization: {
    '@type': 'Organization',
    name: SITE.parent.name,
    url: SITE.parent.url,
  },
  sameAs: [SITE.parent.url],
  areaServed: [
    'Strathroy', 'London', 'St. Thomas', 'Mount Brydges', 'Komoka', 'Delaware',
    'Melbourne', 'Glencoe', 'Kerwood', 'Ailsa Craig', 'Parkhill', 'Grand Bend',
  ].map((n) => ({ '@type': 'City', name: n })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Demo build: keep out of the index until this ships to premierheating.ca -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/premier-logo.png" type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Header active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <div class="callbar">
      <a class="btn btn--primary" href={SITE.phoneHref}>Call {SITE.phone}</a>
      <a class="btn btn--ghost-light" href="/#quote">Get a Quote</a>
    </div>

  </body>
</html>
