---
import { SITE, SERVICES, AREAS, LOCATIONS } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="footer bg-graphite">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src="/assets/premier-logo.png" alt="Premier Heating & Cooling" width="418" height="160" loading="lazy" />
      <p>
        Licensed, insured, TSSA-registered and WSIB-covered. Serving Strathroy,
        London, St. Thomas and rural Middlesex since day one.
      </p>
      <p class="footer__family">
        Proudly part of <a href={SITE.parent.url} target="_blank" rel="noopener">Jayden's Mechanical<span class="visually-hidden"> (opens in a new tab)</span></a>’s Family of Brands.
      </p>
    </div>
    <nav class="footer__col" aria-label="Services">
      <h3>Services</h3>
      <ul>
        {SERVICES.map((s) => <li><a href={`/services/#${s.slug}`}>{s.name}</a></li>)}
      </ul>
    </nav>
    <nav class="footer__col" aria-label="Service areas">
      <h3>Service Areas</h3>
      <ul>
        {LOCATIONS.map((l) => <li><a href={`/locations/${l.slug}/`}>{l.name}</a></li>)}
      </ul>
      <p class="footer__areas">{AREAS.join(' · ')}</p>
    </nav>
    <div class="footer__col">
      <h3>Contact</h3>
      <address>
        <p>{SITE.address.street}<br />{SITE.address.city}, {SITE.address.region} {SITE.address.postal}</p>
        <p><a href={SITE.phoneHref}>{SITE.phone}</a></p>
        <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </address>
      <ul class="footer__pages">
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__legal">
    <p>&copy; {year} {SITE.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer { padding: clamp(48px, 7vw, 80px) 0 0; }
  .footer__grid {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px;
    padding-bottom: 40px;
  }
  .footer__brand img { height: 48px; width: auto; background: var(--white); padding: 6px 10px; border-radius: var(--radius); }
  .footer__brand p { margin-top: 16px; font-size: 0.95rem; max-width: 34ch; }
  .footer h3 {
    font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: #8fa0aa; margin-bottom: 14px;
  }
  .footer ul { list-style: none; display: grid; gap: 8px; }
  .footer a { color: var(--steel-100); text-decoration-color: rgba(255, 255, 255, 0.3); }
  .footer a:hover { color: var(--white); }
  .footer__areas { font-size: 0.88rem; line-height: 1.8; color: #9fadb6; margin-top: 14px; }
  .footer__pages { margin-top: 14px; }
  .footer address { font-style: normal; display: grid; gap: 8px; font-size: 0.95rem; }
  .footer__family { font-size: 0.95rem; }
  .footer__legal {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 18px; font-size: 0.85rem; color: #8fa0aa;
  }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; gap: 28px; } }
</style>
