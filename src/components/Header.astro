---
import { SITE } from '../data/site.js';
const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/services/', label: 'Services', key: 'services' },
  { href: '/locations/st-thomas/', label: 'St. Thomas', key: 'st-thomas' },
];
---
<a class="skip-link" href="#main">Skip to content</a>

<div class="familybar">
  <div class="container familybar__row">
    <img src="/assets/jaydens-logo.png" alt="Jayden's Mechanical" width="152" height="26" loading="eager" />
    <p>
      Now part of the Jayden's Mechanical family. Same staff, same service, same phone number.
      <a href={SITE.parent.url} rel="noopener">Learn more</a>
    </p>
  </div>
</div>

<header class="header">
  <div class="container header__row">
    <a class="header__brand" href="/" aria-label="Premier Heating & Cooling home">
      <img src="/assets/premier-logo.png" alt="Premier Heating & Cooling" width="150" height="60" loading="eager" fetchpriority="high" />
    </a>
    <nav class="header__nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="header__actions">
      <a class="header__phone" href={SITE.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z"/></svg>
        {SITE.phone}
      </a>
      <a class="btn btn--primary header__cta" href="/#quote">Get a Quote</a>
    </div>
  </div>
  <hr class="temp-rule" aria-hidden="true" />
</header>

<style>
  .familybar {
    background: var(--graphite);
    color: #c6cfd5;
    font-size: 0.9rem;
  }
  .familybar__row {
    display: flex; align-items: center; gap: 12px;
    padding-block: 8px; min-height: 40px;
  }
  .familybar img {
    height: 22px; width: auto; flex: none;
    background: var(--white); border-radius: 3px; padding: 2px 6px;
  }
  .familybar p { line-height: 1.35; }
  .familybar a { color: var(--white); text-decoration-color: rgba(255, 255, 255, 0.5); }
  .familybar a:hover { color: var(--white); text-decoration-color: var(--white); }

  .header { background: var(--white); position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow-sm); }
  .header__row { display: flex; align-items: center; gap: 24px; height: 72px; }
  .header__brand { flex: none; }
  .header__brand img { height: 52px; width: auto; }
  .header__nav { display: flex; gap: 22px; margin-left: 8px; }
  .header__nav a {
    text-decoration: none; font-weight: 600; font-size: 1rem; color: var(--ink);
    padding: 6px 2px; border-bottom: 2px solid transparent;
  }
  .header__nav a:hover { color: var(--red); }
  .header__nav a[aria-current='page'] { border-bottom-color: var(--red); }
  .header__actions { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .header__phone {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
    text-decoration: none; color: var(--ink);
  }
  .header__phone:hover { color: var(--red); }
  .header .temp-rule { border-radius: 0; }

  @media (max-width: 900px) {
    .header__phone span { display: none; }
  }
  @media (max-width: 760px) {
    .familybar__row { align-items: flex-start; }
    .familybar img { margin-top: 2px; }
    .header__row { height: 64px; }
    .header__brand img { height: 44px; }
    .header__nav { gap: 14px; }
    .header__nav a { font-size: 0.95rem; }
    .header__actions { display: none; } /* sticky callbar covers mobile */
  }
</style>
