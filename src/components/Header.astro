---
import { SITE, LOCATIONS } from '../data/site.js';
const { active = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/services/', label: 'Services', key: 'services' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/contact/', label: 'Contact', key: 'contact' },
];
// Service Areas is a dropdown so new town pages only need a LOCATIONS entry.
const areasActive = LOCATIONS.some((l) => l.slug === active);
---
<a class="skip-link" href="#main">Skip to content</a>

<div class="familybar">
  <div class="container familybar__row">
    <img src="/assets/jaydens-logo.png" alt="Jayden's Mechanical" width="152" height="26" loading="eager" />
    <p>
      Proudly part of Jayden's Mechanical’s Family of Brands.<span class="familybar__more"> Same service, same phone number.</span>
      <a href={SITE.parent.url} target="_blank" rel="noopener">Learn more<span class="visually-hidden"> about Jayden's Mechanical (opens in a new tab)</span></a>
    </p>
  </div>
</div>

<header class="header" data-header>
  <div class="container header__row">
    <a class="header__brand" href="/" aria-label="Premier Heating & Cooling home">
      <img src="/assets/premier-logo.png" alt="Premier Heating & Cooling" width="418" height="160" loading="eager" fetchpriority="high" />
    </a>

    <button class="header__burger" type="button" aria-expanded="false" aria-controls="site-nav" data-burger>
      <span class="header__burger-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="header__nav" id="site-nav" aria-label="Main" data-nav>
      <a href="/" aria-current={active === 'home' ? 'page' : undefined}>Home</a>
      <a href="/services/" aria-current={active === 'services' ? 'page' : undefined}>Services</a>

      <div class="dd" data-dd>
        <button
          class="dd__toggle"
          type="button"
          aria-expanded="false"
          aria-controls="areas-menu"
          data-dd-toggle
          data-current={areasActive ? 'true' : undefined}
        >
          Service Areas
          <svg class="dd__chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7 7 7-7" /></svg>
        </button>
        <ul class="dd__menu" id="areas-menu" data-dd-menu>
          {LOCATIONS.map((l) => (
            <li>
              <a href={`/locations/${l.slug}/`} aria-current={active === l.slug ? 'page' : undefined}>{l.name}</a>
            </li>
          ))}
          <li class="dd__all"><a href="/contact/#service-area">All towns we serve</a></li>
        </ul>
      </div>

      <a href="/about/" aria-current={active === 'about' ? 'page' : undefined}>About</a>
      <a href="/contact/" aria-current={active === 'contact' ? 'page' : undefined}>Contact</a>

      <div class="header__nav-cta">
        <a class="btn btn--primary" href="/#quote">Get a Quote</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={SITE.phoneHref}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.3 2.2z"/></svg>
        {SITE.phone}
      </a>
      <a class="btn btn--primary header__cta" href="/#quote">Get a Quote</a>
    </div>
  </div>
  <hr class="temp-rule" aria-hidden="true" />
</header>

<style>
  .familybar { background: var(--graphite); color: #c6cfd5; font-size: 0.9rem; }
  .familybar__row { display: flex; align-items: center; gap: 12px; padding-block: 8px; min-height: 40px; }
  .familybar img { height: 22px; width: auto; flex: none; background: var(--white); border-radius: 3px; padding: 2px 6px; }
  .familybar p { line-height: 1.35; }
  .familybar a { color: var(--white); text-decoration-color: rgba(255, 255, 255, 0.5); }
  .familybar a:hover { color: var(--white); text-decoration-color: var(--white); }

  .header { background: var(--white); position: sticky; top: 0; z-index: 100; box-shadow: var(--shadow-sm); }
  .header__row { display: flex; align-items: center; gap: 20px; height: 72px; }
  .header__brand { flex: none; }
  .header__brand img { height: 52px; width: auto; }

  .header__nav { display: flex; align-items: center; gap: 20px; }
  .header__nav > a, .dd__toggle {
    font-family: var(--font-body); font-weight: 600; font-size: 1rem; color: var(--ink);
    text-decoration: none; padding: 6px 2px; border-bottom: 2px solid transparent;
    background: none; border-inline: 0; border-top: 0; white-space: nowrap;
  }
  .header__nav > a:hover, .dd__toggle:hover { color: var(--red); }
  .header__nav > a[aria-current='page'], .dd__toggle[data-current='true'] { border-bottom-color: var(--red); }

  /* ---- Service Areas dropdown ---- */
  .dd { position: relative; }
  .dd__toggle { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .dd__chev { transition: transform var(--dur) var(--ease); }
  .dd__toggle[aria-expanded='true'] .dd__chev { transform: rotate(180deg); }
  .dd__menu {
    position: absolute; top: calc(100% + 10px); left: -14px; z-index: 120;
    min-width: 220px; list-style: none; margin: 0; padding: 6px;
    background: var(--white); border: 1px solid var(--steel-200); border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    display: none;
  }
  .dd__menu[data-open] { display: block; }
  .dd__menu a {
    display: block; padding: 10px 12px; border-radius: var(--radius);
    text-decoration: none; color: var(--ink); font-weight: 500; white-space: nowrap;
  }
  .dd__menu a:hover { background: var(--steel-100); color: var(--red); }
  .dd__menu a[aria-current='page'] { color: var(--red); font-weight: 600; }
  .dd__all { border-top: 1px solid var(--steel-200); margin-top: 4px; padding-top: 4px; }
  .dd__all a { font-size: 0.92rem; color: var(--ink-soft); }

  .header__nav-cta { display: none; }

  .header__actions { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .header__phone {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-display); font-weight: 700; font-size: 1.05rem;
    text-decoration: none; color: var(--ink);
  }
  .header__phone:hover { color: var(--red); }
  .header .temp-rule { border-radius: 0; }

  /* ---- Burger (mobile only) ---- */
  .header__burger {
    display: none; margin-left: auto; align-items: center; justify-content: center;
    width: 46px; height: 46px; background: none; border: 1px solid var(--steel-200);
    border-radius: var(--radius); cursor: pointer;
  }
  .header__burger-bars { display: grid; gap: 4px; }
  .header__burger-bars span {
    display: block; width: 20px; height: 2px; background: var(--ink); border-radius: 2px;
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .header__burger[aria-expanded='true'] .header__burger-bars span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .header__burger[aria-expanded='true'] .header__burger-bars span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded='true'] .header__burger-bars span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  @media (max-width: 1040px) {
    .header__actions .header__phone span { display: none; }
    .header__nav { gap: 16px; }
  }

  /* ---- Mobile: burger panel ---- */
  @media (max-width: 900px) {
    .header__row { height: 64px; gap: 12px; }
    .header__brand img { height: 42px; }
    .header__burger { display: inline-flex; }
    .header__actions { display: none; }

    .header__nav {
      display: none; position: absolute; inset-inline: 0; top: 100%;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--white); border-top: 1px solid var(--steel-200);
      box-shadow: var(--shadow-lg); padding: 8px var(--gutter) 18px;
      max-height: calc(100dvh - 120px); overflow-y: auto;
    }
    .header__nav[data-open] { display: flex; }
    .header__nav > a, .dd__toggle {
      width: 100%; text-align: left; padding: 14px 2px; font-size: 1.05rem;
      border-bottom: 1px solid var(--steel-200); border-radius: 0; min-height: 48px;
    }
    .header__nav > a[aria-current='page'], .dd__toggle[data-current='true'] {
      color: var(--red); border-bottom-color: var(--steel-200);
    }
    .dd { width: 100%; }
    .dd__toggle { display: flex; justify-content: space-between; }
    .dd__menu {
      position: static; display: none; min-width: 0; width: 100%;
      border: 0; box-shadow: none; background: var(--steel-100);
      border-radius: var(--radius); margin: 6px 0 10px; padding: 4px;
    }
    .dd__menu[data-open] { display: block; }
    .dd__menu a { padding: 12px; min-height: 44px; }
    .header__nav-cta { display: block; margin-top: 16px; }
    .header__nav-cta .btn { width: 100%; }
  }

  @media (max-width: 430px) {
    .familybar { font-size: 0.8rem; }
    .familybar__more { display: none; }
    .header__brand img { height: 36px; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  if (header) {
    const burger = header.querySelector('[data-burger]');
    const nav = header.querySelector('[data-nav]');
    const dd = header.querySelector('[data-dd]');
    const ddToggle = header.querySelector('[data-dd-toggle]');
    const ddMenu = header.querySelector('[data-dd-menu]');
    const isMobile = () => window.matchMedia('(max-width: 900px)').matches;

    const setNav = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      if (open) nav.setAttribute('data-open', ''); else nav.removeAttribute('data-open');
    };
    const setDd = (open) => {
      ddToggle.setAttribute('aria-expanded', String(open));
      if (open) ddMenu.setAttribute('data-open', ''); else ddMenu.removeAttribute('data-open');
    };

    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      setNav(!open);
      if (open) setDd(false);
    });

    // Click-only disclosure. Hover-to-open was removed on purpose: it fought the
    // click handler (pointer enter opened, the click then closed it) and it is
    // unreliable on touch. A menu button is also the accessible standard here.
    ddToggle.addEventListener('click', () => setDd(ddToggle.getAttribute('aria-expanded') !== 'true'));

    // Close the dropdown when focus moves to something outside it (keyboard users).
    // relatedTarget is null when the whole window loses focus; ignore that case so
    // the menu does not close behind the user's back.
    dd.addEventListener('focusout', (e) => {
      if (!isMobile() && e.relatedTarget && !dd.contains(e.relatedTarget)) setDd(false);
    });

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target)) { setDd(false); setNav(false); }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (ddToggle.getAttribute('aria-expanded') === 'true') { setDd(false); ddToggle.focus(); return; }
      if (burger.getAttribute('aria-expanded') === 'true') { setNav(false); burger.focus(); }
    });

    // Reset state when crossing the breakpoint so no panel is left stranded open.
    window.matchMedia('(max-width: 900px)').addEventListener('change', () => { setNav(false); setDd(false); });
  }
</script>
